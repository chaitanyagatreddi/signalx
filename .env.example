# signalx - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to version control.

# ----------------------------------------------
# Required
# ---------------------------------------------

# GitHub Personal Access Token (needs read:user + public_repo scopes)
GITHUB_TOKEN=ghp_your_token_here

# OpenAI API key (gpt-4o-mini is used for scoring contributors)
OPENAI_API_KEY=sk-your_key_here

# -----------------------------------------------
# Optional - Email & Enrichment
# ----------------------------------------------

# Resend API key (for sending welcome emails to gate signups)
RESEND_API_KEY=re_your_key_here

# Context.dev API key (company enrichment for gate leads)
CONTEXT_DEV_API_KEY=your_key_here

# ----------------------------------------------
# Server
# ----------------------------------------------

# Port for the Flask server (defaults to 7860 if not set)
PORT=7860
